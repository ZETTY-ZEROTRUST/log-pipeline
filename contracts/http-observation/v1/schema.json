{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZETTY local HTTP observation v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "zetty-http-observation/1"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "environment": {
      "const": "local-lab"
    },
    "client_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "key_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,40}$"
    },
    "method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS",
        "CONNECT",
        "TRACE"
      ]
    },
    "status_code": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "response_body_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "occurred_at",
    "environment",
    "client_key",
    "path_key",
    "key_version",
    "method",
    "status_code",
    "response_body_bytes"
  ],
  "additionalProperties": false
}
