{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zetty:contracts:response-command:v1",
  "title": "ResponseCommand v1",
  "description": "별도 response policy가 만들고 Auth/BFF가 집행하는 조치 명령(response-command/1.0). 원본 의미: log-pipeline docs/contracts.md §5. UBA 모델은 이 명령을 직접 집행하지 않는다. 집행 측은 이 schema 통과만으로 명령을 신뢰하지 않고 command_id 멱등·유효 기간·environment·현재 상태 version·대상 범위·호출자 자격을 다시 검증한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "detection_id",
    "incident_id",
    "policy_version",
    "action",
    "target_type",
    "target_key",
    "environment",
    "requested_at",
    "expires_at",
    "mode",
    "evidence_ref",
    "expected_state_version"
  ],
  "properties": {
    "schema_version": { "const": "response-command/1.0" },
    "command_id": {
      "$comment": "멱등 키. 재전송(retry)은 같은 command_id를 사용한다.",
      "$ref": "#/$defs/uuid"
    },
    "detection_id": {
      "$comment": "anomaly-detection/1.0 의 detection_id(sha256 hex).",
      "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }]
    },
    "incident_id": {
      "anyOf": [{ "$ref": "#/$defs/pseudonymous_key" }, { "type": "null" }]
    },
    "policy_version": { "$ref": "#/$defs/version_token" },
    "action": { "enum": ["RATE_LIMIT", "REQUIRE_REAUTH", "REVOKE_SESSION", "LOCK_ACCOUNT"] },
    "target_type": { "enum": ["SUBJECT", "SESSION", "IP"] },
    "target_key": {
      "$comment": "가명 key. 실제 계정 매핑 권한은 집행 측에만 있다.",
      "$ref": "#/$defs/keyed_ref"
    },
    "environment": { "enum": ["local-secure", "local-lab", "synthetic"] },
    "requested_at": { "$ref": "#/$defs/utc_timestamp" },
    "expires_at": {
      "$comment": "requested_at 보다 뒤여야 한다(validate.py). 만료된 명령은 집행하지 않고 REJECTED/EXPIRED.",
      "$ref": "#/$defs/utc_timestamp"
    },
    "mode": {
      "$comment": "초기 default는 DRY_RUN. ENFORCE는 local 모의 계정의 명시된 시험 범위.",
      "enum": ["DRY_RUN", "ENFORCE"]
    },
    "evidence_ref": {
      "$comment": "'anomaly-detection:<detection_id>' 또는 'incident:<incident_id>'. 가리키는 ID는 같은 명령의 detection_id/incident_id와 일치해야 한다(validate.py).",
      "type": "string",
      "pattern": "^(anomaly-detection:[0-9a-f]{64}|incident:[A-Za-z0-9_-]{1,128})$"
    },
    "expected_state_version": {
      "$comment": "policy가 관측한 대상의 상태 version. 집행 시점 version과 다르면 stale로 거부한다.",
      "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
    }
  },
  "allOf": [
    {
      "title": "command_has_basis",
      "$comment": "근거 없는 조치 명령 금지. detection_id 또는 incident_id 중 하나 이상.",
      "anyOf": [
        { "properties": { "detection_id": { "type": "string" } } },
        { "properties": { "incident_id": { "type": "string" } } }
      ]
    },
    {
      "title": "action_target_compatibility",
      "allOf": [
        {
          "if": { "required": ["action"], "properties": { "action": { "const": "LOCK_ACCOUNT" } } },
          "then": { "properties": { "target_type": { "const": "SUBJECT" } } }
        },
        {
          "if": { "required": ["action"], "properties": { "action": { "enum": ["REVOKE_SESSION", "REQUIRE_REAUTH"] } } },
          "then": { "properties": { "target_type": { "enum": ["SUBJECT", "SESSION"] } } }
        }
      ]
    },
    {
      "title": "enforce_requires_state_version",
      "$comment": "상태 version 없이 ENFORCE하면 stale 명령을 구분할 수 없다.",
      "if": { "required": ["mode"], "properties": { "mode": { "const": "ENFORCE" } } },
      "then": { "properties": { "expected_state_version": { "type": "integer" } } }
    },
    {
      "title": "synthetic_is_dry_run_only",
      "$comment": "synthetic 환경에는 실제 집행 대상 계정이 없다.",
      "if": { "required": ["environment"], "properties": { "environment": { "const": "synthetic" } } },
      "then": { "properties": { "mode": { "const": "DRY_RUN" } } }
    }
  ],
  "$defs": {
    "no_raw_secret": {
      "not": {
        "anyOf": [
          { "type": "string", "pattern": "eyJ[A-Za-z0-9_-]+[.][A-Za-z0-9_-]+[.]" },
          { "type": "string", "pattern": "[Bb][Ee][Aa][Rr][Ee][Rr][ ]" }
        ]
      }
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]{1,6})?Z$"
    },
    "pseudonymous_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "allOf": [{ "$ref": "#/$defs/no_raw_secret" }]
    },
    "version_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
      "allOf": [{ "$ref": "#/$defs/no_raw_secret" }]
    },
    "keyed_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "key_version"],
      "properties": {
        "key": { "$ref": "#/$defs/pseudonymous_key" },
        "key_version": { "$ref": "#/$defs/version_token" }
      }
    }
  }
}
